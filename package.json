{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:unit": "bun test src/",
    "test:integration": "bun test tests/integration/",
    "test": "bun test src/ tests/integration/",
    "check": "tsc --noEmit && bun run test && vite build",
    "test:e2e": "node tests/e2e/run.mjs test --project=ui",
    "test:smoke": "PW_SKIP_WEBSERVER=1 node tests/e2e/run.mjs test --project=smoke"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@google/genai": "^3.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/multer": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "lucide-react": "^0.546.0",
    "mp4box": "^2.5.0",
    "multer": "^2.5.0",
    "onnxruntime-web": "^1.31.1",
    "openid-client": "^6.9.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
