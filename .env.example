# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The origin the browser opens (http://localhost:3003 with Docker Compose, http://localhost:3000 with
# `bun run dev`); the Keycloak redirect URI is <APP_URL>/auth/callback, so register one per origin you use.
APP_URL="http://localhost:3003"

# Keycloak sign-in (confidential client). Keep the client secret only in .env.
KEYCLOAK_ISSUER_URL="https://accounts.rtt.in.th/auth/realms/rtt"
KEYCLOAK_CLIENT_ID="envisio-dev"
KEYCLOAK_CLIENT_SECRET=""

# SESSION_SECRET: at least 32 random characters, e.g. from `openssl rand -base64 48`.
# Changing it signs every Author out. The server will not start while it or the client secret is empty.
SESSION_SECRET=""

# AUTH_ALL_JOBS_GROUPS: Keycloak groups whose members see every Job (default admin,supervisor).
# AUTH_ALL_JOBS_GROUPS="admin,supervisor"
